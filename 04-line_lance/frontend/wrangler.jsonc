{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-lance-ui",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "LANCE_API_URL": "https://replace-with-your-private-lance-api.example"
  }
}

